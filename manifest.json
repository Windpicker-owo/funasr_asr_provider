{
    "name": "funasr_asr_provider",
    "display_name": "FunASR 语音识别后端",
    "version": "1.0.1",
    "description": "独立的 FunASR ASR provider，通过 asr_adapter registry 注册识别后端",
    "author": "MoFox Team",
    "dependencies": {
        "plugins": ["asr_adapter>=1.0.0"],
        "components": ["asr_adapter:service:asr_provider_registry"]
    },
    "include": [],
    "categories": ["tool"],
    "tags": ["asr", "provider", "funasr"],
    "entry_point": "plugin.py",
    "min_core_version": "1.2.0-alpha",
    "python_dependencies": [
        "funasr>=1.2.0",
        "sounddevice>=0.5.0",
        "numpy>=2.0.0",
        "torch>=2.0.0",
        "torchaudio>=2.0.0",
        "transformers>=5.8.0",
        "tokenizers>=0.22.2,<0.23.0",
        "modelscope>=1.17.0",
        "huggingface-hub>=1.0.0"
    ],
    "dependencies_required": true
}